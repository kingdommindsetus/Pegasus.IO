# Pegasus.io environment template
# Copy to .env.local for local development.
# NEVER commit real credentials. Keep this committed template empty.

# REQUIRED — direct Google AI Studio reasoning
GOOGLE_GENERATIVE_AI_API_KEY=

# REQUIRED — ElevenLabs primary voice provider
ELEVENLABS_API_KEY=

# REQUIRED — Postgres database used by Pegasus Core
DATABASE_URL=

# REQUIRED — long random secret used to sign/authenticate Pegasus Core sessions
PEGASUS_CORE_API_SECRET=

# OPTIONAL — custom Gemini model rotation
# Default is enforced in code when blank.
PEGASUS_REASONING_MODELS=

# OPTIONAL — shared Google free-tier quota governor tuning
GOOGLE_REASONING_RPM=
GOOGLE_REASONING_WINDOW_MS=
GOOGLE_REASONING_SAFETY_MS=

# OPTIONAL — ElevenLabs model override
ELEVENLABS_TTS_MODEL=

# OPTIONAL — external CRM connector
PEGASUS_CRM_URL=
PEGASUS_CRM_TOKEN=

# REQUIRED — separate strong founder password to issue a signed session cookie
PEGASUS_ADMIN_PASSWORD=

# REQUIRED for organization-scoped founder activity (UUID of the approved company)
PEGASUS_FOUNDER_ORGANIZATION_ID=

# MANUAL BOOTSTRAP ONLY — dedicated non-production company database verification
# Never provision production from this script; leave these unset during normal runtime.
PEGASUS_BOOTSTRAP_ENV=
PEGASUS_BOOTSTRAP_EXPECTED_HOST=
PEGASUS_BOOTSTRAP_EXPECTED_DB=
PEGASUS_BOOTSTRAP_EXPECTED_ROLE=
PEGASUS_BOOTSTRAP_CONFIRM=

# LOCAL RUNTIME / DEVELOPMENT
# Vercel supplies VERCEL_ENV automatically in deployed functions; do not set manually.
VERCEL_ENV=
PORT=
NODE_ENV=
DISABLE_HMR=

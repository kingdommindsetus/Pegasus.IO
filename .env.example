# Pegasus.io environment template
# Copy to .env.local for local development.
# NEVER commit real credentials. Keep this committed template empty.

# REQUIRED — direct Google AI Studio reasoning
GOOGLE_GENERATIVE_AI_API_KEY=

# REQUIRED — Postgres database used by Pegasus Core
DATABASE_URL=

# REQUIRED — long random secret used to sign/authenticate Pegasus Core sessions
PEGASUS_CORE_API_SECRET=

# OPTIONAL — custom Gemini model rotation
# Default is enforced in code when blank.
PEGASUS_REASONING_MODELS=

# OPTIONAL — shared Google free-tier quota governor tuning
GOOGLE_REASONING_RPM=
GOOGLE_REASONING_WINDOW_MS=
GOOGLE_REASONING_SAFETY_MS=

# OPTIONAL — external CRM connector
PEGASUS_CRM_URL=
PEGASUS_CRM_TOKEN=

# OPTIONAL / legacy compatibility
PEGASUS_ADMIN_PASSWORD=

# LOCAL RUNTIME / DEVELOPMENT
PORT=
NODE_ENV=
DISABLE_HMR=

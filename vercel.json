{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/api/agent/chat", "dest": "https://pegasus-io.vercel.app/api/chat" },
    { "src": "/api/(.*)", "dest": "https://pegasus-io.vercel.app/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
